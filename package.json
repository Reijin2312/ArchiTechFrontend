{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/raster-resize.mjs && node scripts/build-og.mjs && node scripts/build-sitemap.mjs",
    "build": "tsc -b && vite build",
    "ssg:prep": "tsc -p tsconfig.ssg.json && tsc-alias -p tsconfig.ssg.json --resolve-full-paths",
    "ssg": "node scripts/prerender.mjs",
    "build:prod": "npm run assets && npm run build && npm run ssg:prep && npm run ssg"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.12.2",
    "framer-motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "react-router": "^7.9.5",
    "react-router-dom": "^7.9.5",
    "react-turnstile": "^1.1.4",
    "skinview3d": "^3.4.1",
    "sonner": "^2.0.7",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.15",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^5.4.10"
  }
}
