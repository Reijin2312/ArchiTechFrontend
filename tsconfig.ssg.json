{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-ssg",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": "./",
