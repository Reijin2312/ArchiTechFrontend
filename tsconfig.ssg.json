{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-ssg",
    "rootDir": "./src",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "skipLibCheck": true,
    "noEmit": false,
    "isolatedModules": false
  },
  "include": [
    "src/ssg/**/*",
    "src/pages/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}